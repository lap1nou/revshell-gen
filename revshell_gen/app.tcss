/* revshell-gen TUI stylesheet.
 *
 * Layout note: Textual's Horizontal/Vertical containers default to
 * `height: 1fr`. Nesting one of those, unstyled, inside an `auto`-height
 * ancestor makes the ancestor's auto-size resolve against a fraction unit
 * with nothing to divide -- in practice it grabs almost the whole screen.
 * Every row/column below is given an explicit height for that reason.
 */

Screen {
    layout: vertical;
}

#top {
    height: 1fr;
}

#table_container {
    width: 2fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#search {
    height: 3;
    margin-bottom: 1;
}

#table {
    height: 1fr;
}

#form {
    width: 1fr;
    height: 1fr;
    border: round $primary;
    padding: 1;
    overflow-y: auto;
}

#form Input,
#form Select {
    margin-bottom: 1;
}

/* Collapse the custom-IP field entirely (no residual margin/row) unless the
 * "Custom (type below)" IP option is selected. */
#form .hidden {
    display: none;
}

#preview_container {
    height: auto;
    border: round $accent;
    padding: 1;
    margin-top: 1;
}

#preview_row {
    height: auto;
}

#preview {
    width: 1fr;
    color: $success;
    content-align: left middle;
}

#preview.error {
    color: $error;
}

#copy_button {
    width: auto;
    min-width: 10;
    margin-left: 1;
}
